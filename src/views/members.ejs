<%- include('partials/nav') %>
<main class="container">
  <h1><%= t(locale, 'members_title') %></h1>

  <details class="new-form">
    <summary><%= t(locale, 'add_member') %></summary>
    <form method="POST" action="/members" class="form-grid">
      <label><%= t(locale, 'first_name') %><input name="first_name" required></label>
      <label><%= t(locale, 'last_name') %><input name="last_name" required></label>
      <label><%= t(locale, 'date_of_birth') %><input type="date" name="date_of_birth"></label>
      <label><%= t(locale, 'member_type') %>
        <select name="member_type">
          <option value="participant"><%= t(locale, 'participant') %></option>
          <option value="official"><%= t(locale, 'official') %></option>
          <option value="coach"><%= t(locale, 'coach') %></option>
          <option value="volunteer"><%= t(locale, 'volunteer') %></option>
        </select>
      </label>
      <label><%= t(locale, 'organization') %>
        <select name="org_id" required>
          <% clubs.forEach(c => { %>
            <option value="<%= c.id %>"><%= locale === 'fr' && c.name_fr ? c.name_fr : c.name_en %></option>
          <% }) %>
        </select>
      </label>
      <div class="form-actions"><button class="btn-primary" type="submit"><%= t(locale, 'save') %></button></div>
    </form>
  </details>

  <section class="panel">
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org') %></th>
        <th><%= t(locale, 'col_type') %></th>
        <th><%= t(locale, 'col_uci') %></th>
        <th><%= t(locale, 'col_status') %></th>
      </tr></thead>
      <tbody>
      <% members.forEach(m => { %>
        <tr>
          <td><%= m.first_name %> <%= m.last_name %></td>
          <td><%= locale === 'fr' && m.org_name_fr ? m.org_name_fr : m.org_name_en %></td>
          <td><%= t(locale, m.member_type) %></td>
          <td><%= m.uci_id || '—' %></td>
          <td>
            <% if (m.latest_status) { %>
              <span class="status-badge status-<%= m.latest_status %>"><%= t(locale, m.latest_status) %></span>
            <% } else { %>—<% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!members.length) { %><tr><td colspan="5" class="muted">—</td></tr><% } %>
      </tbody>
    </table>
  </section>
  <p class="footer-note"><%= t(locale, 'footer_note') %></p>
</main>
