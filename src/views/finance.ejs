<%- include('partials/nav') %>
<main class="container">
  <h1><%= t(locale, 'finance_title') %></h1>

  <div class="kpi-grid">
    <% totals.forEach(tot => { %>
      <div class="kpi-card">
        <div class="kpi-value"><%= (tot.total/100).toLocaleString('en-CA', {style:'currency', currency:'CAD'}) %></div>
        <div class="kpi-label"><%= t(locale, tot.tx_type === 'membership_fee' ? 'nav_memberships' : 'nav_finance') %> (<%= tot.n %>)</div>
      </div>
    <% }) %>
  </div>

  <section class="panel">
    <div class="panel-header">
      <h2><%= t(locale, 'finance_title') %></h2>
      <a class="btn-secondary" href="/finance/export.csv"><%= t(locale, 'export_accounting') %></a>
    </div>
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org') %></th>
        <th><%= t(locale, 'col_amount') %></th>
        <th><%= t(locale, 'col_tx_type') %></th>
        <th><%= t(locale, 'col_reconciled') %></th>
        <th><%= t(locale, 'col_external_ref') %></th>
        <th><%= t(locale, 'col_actions') %></th>
      </tr></thead>
      <tbody>
      <% transactions.forEach(tx => { %>
        <tr>
          <td><%= tx.first_name ? `${tx.first_name} ${tx.last_name}` : '—' %></td>
          <td><%= locale === 'fr' && tx.org_name_fr ? tx.org_name_fr : tx.org_name_en %></td>
          <td><%= (tx.amount_cents/100).toLocaleString('en-CA', {style:'currency', currency: tx.currency}) %></td>
          <td><%= tx.tx_type %></td>
          <td><%= tx.reconciled ? t(locale, 'yes') : t(locale, 'no') %></td>
          <td><%= tx.external_ref || '—' %></td>
          <td>
            <% if (!tx.reconciled) { %>
              <form method="POST" action="/finance/<%= tx.id %>/reconcile">
                <button class="btn-secondary" type="submit"><%= t(locale, 'mark_reconciled') %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!transactions.length) { %><tr><td colspan="7" class="muted">—</td></tr><% } %>
      </tbody>
    </table>
  </section>
  <p class="footer-note"><%= t(locale, 'footer_note') %></p>
</main>
