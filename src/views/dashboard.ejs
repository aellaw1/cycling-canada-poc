<%- include('partials/nav') %>

<div class="page-header">
  <h1 class="page-title"><i class="fa-solid fa-gauge-high" style="color:var(--red);margin-right:8px"></i><%= t(locale, 'dashboard_title') %></h1>
  <p class="page-subtitle"><%= t(locale, 'dashboard_scope') %>: <strong><%= locals.scopeLabel || '' %></strong></p>
</div>

<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
    <div class="kpi-value"><%= kpis.totalMembers %></div>
    <div class="kpi-label"><%= t(locale, 'kpi_total_members') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon"><i class="fa-solid fa-id-card"></i></div>
    <div class="kpi-value"><%= kpis.activeMemberships %></div>
    <div class="kpi-label"><%= t(locale, 'kpi_active_memberships') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:var(--green-light);color:var(--green)"><i class="fa-solid fa-money-bill-trend-up"></i></div>
    <div class="kpi-value"><%= fmtMoney(kpis.revenueYtd) %></div>
    <div class="kpi-label"><%= t(locale, 'kpi_revenue_ytd') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:var(--amber-light);color:var(--amber)"><i class="fa-solid fa-triangle-exclamation"></i></div>
    <div class="kpi-value"><%= kpis.pendingCompliance %></div>
    <div class="kpi-label"><%= t(locale, 'kpi_pending_compliance') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:var(--green-light);color:var(--green)"><i class="fa-solid fa-certificate"></i></div>
    <div class="kpi-value"><%= kpis.uciIssued %></div>
    <div class="kpi-label"><%= t(locale, 'kpi_uci_licences') %></div>
  </div>
</div>

<% if (childOrgs.length) { %>
<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="fa-solid fa-sitemap" style="color:var(--red);margin-right:8px"></i><%= t(locale, 'child_orgs') %></span>
    <span class="badge badge-gray"><%= childOrgs.length %> <%= locale === 'fr' ? 'organisations' : 'organizations' %></span>
  </div>
  <div class="card-body table-wrap">
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org_type') %></th>
        <th><%= t(locale, 'col_jurisdiction') %></th>
      </tr></thead>
      <tbody>
      <% childOrgs.forEach(o => { %>
        <tr>
          <td class="td-name"><%= locale === 'fr' && o.name_fr ? o.name_fr : o.name_en %></td>
          <td><span class="badge badge-<%= o.org_type.toLowerCase() %>"><%= o.org_type %></span></td>
          <td><%= o.jurisdiction || '—' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="fa-solid fa-clock-rotate-left" style="color:var(--red);margin-right:8px"></i><%= t(locale, 'recent_registrations') %></span>
    <a class="btn btn-secondary btn-sm" href="/finance/export.csv"><i class="fa-solid fa-file-csv"></i> <%= t(locale, 'export_csv') %></a>
  </div>
  <div class="card-body table-wrap">
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org') %></th>
        <th><%= t(locale, 'col_season') %></th>
        <th><%= t(locale, 'col_membership_type') %></th>
      </tr></thead>
      <tbody>
      <% recentRegistrations.forEach(r => { %>
        <tr>
          <td class="td-name"><%= r.first_name %> <%= r.last_name %></td>
          <td><%= locale === 'fr' && r.org_name_fr ? r.org_name_fr : r.org_name %></td>
          <td><%= r.season_year %></td>
          <td><span class="badge badge-gray"><%= t(locale, r.membership_type) %></span></td>
        </tr>
      <% }) %>
      <% if (!recentRegistrations.length) { %><tr><td colspan="4" style="text-align:center;color:var(--gray-400);padding:24px">— <%= locale === 'fr' ? 'Aucune inscription récente' : 'No recent registrations' %> —</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<p class="footer-note"><i class="fa-solid fa-flask"></i> <%= t(locale, 'footer_note') %></p>
<%- include('partials/footer') %>
