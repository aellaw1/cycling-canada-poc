<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CC National Membership Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="app-shell">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo">🚴</div>
      <div>
        <span class="sidebar-brand-name"><%= t(locale, 'app_name_short') %></span>
        <span class="sidebar-brand-tag">National Platform</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <span class="nav-section-label"><%= locale === 'fr' ? 'Navigation' : 'Navigation' %></span>
      <a href="/dashboard" class="sidebar-link <%= locals.activePage === 'dashboard' ? 'active' : '' %>">
        <i class="fa-solid fa-gauge-high"></i> <%= t(locale, 'nav_dashboard') %>
      </a>
      <a href="/members" class="sidebar-link <%= locals.activePage === 'members' ? 'active' : '' %>">
        <i class="fa-solid fa-users"></i> <%= t(locale, 'nav_members') %>
      </a>
      <a href="/memberships" class="sidebar-link <%= locals.activePage === 'memberships' ? 'active' : '' %>">
        <i class="fa-solid fa-id-card"></i> <%= t(locale, 'nav_memberships') %>
      </a>

      <span class="nav-section-label" style="margin-top:8px"><%= locale === 'fr' ? 'Activités' : 'Activities' %></span>
      <a href="/events" class="sidebar-link <%= locals.activePage === 'events' ? 'active' : '' %>">
        <i class="fa-solid fa-flag-checkered"></i> <%= t(locale, 'nav_events') %>
      </a>
      <a href="/compliance" class="sidebar-link <%= locals.activePage === 'compliance' ? 'active' : '' %>">
        <i class="fa-solid fa-shield-halved"></i> <%= t(locale, 'nav_compliance') %>
      </a>

      <span class="nav-section-label" style="margin-top:8px"><%= locale === 'fr' ? 'Administration' : 'Administration' %></span>
      <a href="/finance" class="sidebar-link <%= locals.activePage === 'finance' ? 'active' : '' %>">
        <i class="fa-solid fa-money-bill-trend-up"></i> <%= t(locale, 'nav_finance') %>
      </a>
      <a href="/orgs" class="sidebar-link <%= locals.activePage === 'orgs' ? 'active' : '' %>">
        <i class="fa-solid fa-sitemap"></i> <%= t(locale, 'nav_orgs') %>
      </a>
      <a href="/audit" class="sidebar-link <%= locals.activePage === 'audit' ? 'active' : '' %>">
        <i class="fa-solid fa-clipboard-list"></i> <%= locale === 'fr' ? 'Journal d\'audit' : 'Audit Log' %>
      </a>
    </nav>
  </aside>

  <!-- MAIN AREA -->
  <div class="main-area">
    <header class="topbar">
      <!-- Left: scope -->
      <div class="topbar-left">
        <% if (locals.scopeLabel) { %>
        <span class="scope-badge"><%= scopeLabel %></span>
        <% } %>
      </div>

      <!-- Right: user info + actions (always visible, top-right) -->
      <div class="topbar-user">
        <% if (user) { %>
          <div class="topbar-avatar"><%= (user.first_name || 'U')[0].toUpperCase() %></div>
          <div class="topbar-user-info">
            <span class="topbar-user-name"><%= user.first_name %> <%= user.last_name %></span>
            <span class="topbar-user-role"><%= scope ? scope.highestRole : '' %></span>
          </div>
        <% } %>
        <div class="topbar-actions">
          <form method="POST" action="/locale/<%= locale === 'en' ? 'fr' : 'en' %>">
            <button class="topbar-btn" type="submit">
              <i class="fa-solid fa-language"></i> <%= locale === 'en' ? 'FR' : 'EN' %>
            </button>
          </form>
          <form method="POST" action="/logout">
            <button class="topbar-btn" type="submit">
              <i class="fa-solid fa-right-from-bracket"></i> <%= t(locale, 'nav_logout') %>
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="page-content">
