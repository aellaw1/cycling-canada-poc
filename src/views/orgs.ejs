<%- include('partials/nav') %>

<div class="page-header">
  <h1 class="page-title"><i class="fa-solid fa-sitemap" style="color:var(--red);margin-right:8px"></i><%= t(locale, 'orgs_title') %></h1>
  <p class="page-subtitle"><%= locale === 'fr' ? 'Cyclisme Canada · PTSOs · Clubs affiliés' : 'Cycling Canada · PTSOs · Affiliated Clubs' %></p>
</div>

<div class="card">
  <div class="card-body table-wrap">
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org_type') %></th>
        <th><%= t(locale, 'col_jurisdiction') %></th>
        <th><%= t(locale, 'col_parent') %></th>
        <th>Code</th>
        <th><%= t(locale, 'col_status') %></th>
      </tr></thead>
      <tbody>
      <% orgs.forEach(o => { %>
        <tr>
          <td class="td-name"><%= locale === 'fr' && o.name_fr ? o.name_fr : o.name_en %></td>
          <td><span class="badge badge-<%= o.org_type.toLowerCase() %>"><%= o.org_type %></span></td>
          <td><%= o.jurisdiction || '—' %></td>
          <td><span class="td-muted"><%= o.parent_name_en ? (locale === 'fr' && o.parent_name_fr ? o.parent_name_fr : o.parent_name_en) : '—' %></span></td>
          <td><code style="font-size:11px;background:var(--gray-100);padding:2px 6px;border-radius:4px"><%= o.code %></code></td>
          <td><span class="badge badge-<%= o.status %>"><%= t(locale, o.status) %></span></td>
        </tr>
      <% }) %>
      <% if (!orgs.length) { %><tr><td colspan="6" style="text-align:center;padding:32px;color:var(--gray-400)">—</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<p class="footer-note"><i class="fa-solid fa-flask"></i> <%= t(locale, 'footer_note') %></p>
<%- include('partials/footer') %>
