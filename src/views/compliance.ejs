<%- include('partials/nav') %>
<main class="container">
  <h1><%= t(locale, 'compliance_title') %></h1>
  <section class="panel">
    <table>
      <thead><tr>
        <th><%= t(locale, 'col_name') %></th>
        <th><%= t(locale, 'col_org') %></th>
        <th><%= t(locale, 'col_compliance_type') %></th>
        <th><%= t(locale, 'col_status') %></th>
        <th><%= t(locale, 'col_completed') %></th>
        <th><%= t(locale, 'col_expires') %></th>
        <th><%= t(locale, 'col_actions') %></th>
      </tr></thead>
      <tbody>
      <% records.forEach(r => { %>
        <tr>
          <td><%= r.first_name %> <%= r.last_name %></td>
          <td><%= locale === 'fr' && r.org_name_fr ? r.org_name_fr : r.org_name_en %></td>
          <td><%= r.compliance_type %></td>
          <td><span class="status-badge status-<%= r.status %>"><%= t(locale, r.status) %></span></td>
          <td><%= r.completed_at || '—' %></td>
          <td><%= r.expires_at || '—' %></td>
          <td>
            <% if (r.status === 'pending') { %>
              <form method="POST" action="/compliance/<%= r.id %>/complete">
                <button class="btn-secondary" type="submit"><%= t(locale, 'complete') %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!records.length) { %><tr><td colspan="7" class="muted">—</td></tr><% } %>
      </tbody>
    </table>
  </section>
  <p class="footer-note"><%= t(locale, 'footer_note') %></p>
</main>
